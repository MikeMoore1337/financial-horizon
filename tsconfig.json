{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "jsx": "react-jsx"
  },
  "include": [
    "src/types/**/*.ts",
    "state-migrations.ts",
    "src/react/**/*.tsx",
    "tests/react/**/*.tsx",
    "src/domain/accounts/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "backend", "tests"]
}
