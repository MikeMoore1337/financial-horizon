# Example ONLY - not loaded by the current static PWA.
# Do not commit real values. Provision the future server environment separately on Hermes VPS.
# Required before enabling any cloud feature: complete issues #7, #8, #9 and security acceptance.
FH_ENABLE_CLOUD_AUTH=false
FH_PUBLIC_URL=https://fin-horizon.mikemoore.top
FH_AUTH_DATABASE_PATH=/var/lib/financial-horizon/auth.sqlite3
FH_AUTH_RATE_SECRET=
FH_DATABASE_URL=
FH_SESSION_SECRET=
# OAuth uses FH_AUTH_DATABASE_PATH and fh_email_session. Never configure a second DB.
# Keep every provider DISABLED until real-client/browser/security approval.

# Independent OAuth applications: NEVER use another project's credentials.
FH_TELEGRAM_OAUTH_ENABLED=false
FH_TELEGRAM_OAUTH_CLIENT_ID=
FH_TELEGRAM_OAUTH_CLIENT_SECRET=
FH_GOOGLE_OAUTH_ENABLED=false
FH_GOOGLE_OAUTH_CLIENT_ID=
FH_GOOGLE_OAUTH_CLIENT_SECRET=
FH_YANDEX_OAUTH_ENABLED=false
FH_YANDEX_OAUTH_CLIENT_ID=
FH_YANDEX_OAUTH_CLIENT_SECRET=
FH_VK_OAUTH_ENABLED=false
FH_VK_OAUTH_CLIENT_ID=

# Email/password registration and transaction email.
FH_EMAIL_AUTH_ENABLED=false
FH_SMTP_HOST=
FH_SMTP_PORT=587
FH_SMTP_FROM_EMAIL=
FH_SMTP_USERNAME=
FH_SMTP_PASSWORD=

# Antibot. Site key is public; the secret key is server-only.
FH_TURNSTILE_SITE_KEY=
FH_TURNSTILE_SECRET_KEY=

# Independent HTTPS-only callback endpoints (planned, NOT implemented yet):
# https://fin-horizon.mikemoore.top/api/auth/oauth/telegram/callback
# https://fin-horizon.mikemoore.top/api/auth/oauth/google/callback
# https://fin-horizon.mikemoore.top/api/auth/oauth/yandex/callback
# https://fin-horizon.mikemoore.top/api/auth/oauth/vk/callback
