[Unit]
Description=Financial Horizon personal PostgreSQL (guarded local storage)
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/financial-horizon/finance/start.env
ExecStart=/usr/bin/bash -c 'exec /usr/bin/bash "$FH_FINANCE_CHECKOUT_DIR/deploy/postgres/scripts/personal-start.sh"'
ExecStop=-/usr/bin/docker stop --time=30 fh-finance-postgres
TimeoutStartSec=180
TimeoutStopSec=50
UMask=0077
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
