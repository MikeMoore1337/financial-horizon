{
  "openapi": "3.1.0",
  "info": {
    "title": "Financial Horizon - Accounts and linked payment v2 candidate (NOT LIVE)",
    "version": "2.0.0-candidate",
    "description": "Unapproved feature-off #33/#67 proposal: account CRUD, actual cash movements, confirmed linked obligations/loans, one-step fact void + append-only cash reversal. No deployment. Source-owned server-generated payment fact/transaction UUIDs from owner-scoped mutation keys. #6 draft reserve-plan CRUD and non-ledger allocation are additive; payment/void and owner UI remain NOT_READY. Reserved settlement payments optionally use one owner-scoped reserve; the same transaction releases earmarked funds, and the void reverses cash and restores that reservation atomically."
  },
  "x-go-live": "NO_GO",
  "x-account-v2-opt-in-default": false,
  "x-approved": false,
  "x-related-bootstrap": "/api/auth/email/finance/session",
  "x-authoritative-read": "/api/finance/v1/state",
  "x-supported-currency": "RUB",
  "paths": {
    "/api/finance/v2/commands/cancel": {
      "post": {
        "summary": "Explicitly fence an exact uncommitted v2 request without reversing a committed operation",
        "x-feature-off": true,
        "x-verified-session-required": true,
        "security": [{"financeV2Cookie":[]}],
        "parameters": [
          {"name":"If-Match","in":"header","required":true,"schema":{"type":"string"},"description":"Original strong ETag, not the current snapshot tag"},
          {"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","format":"uuid"}},
          {"name":"X-FH-Expected-Profile","in":"header","required":false,"schema":{"type":"string","format":"uuid"}}
        ],
        "requestBody": {"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AccountV2Candidate"}}}},
        "responses": {
          "200": {"description":"A durable tombstone fences the exact request without a financial revision", "content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommandCancellation"}}}},
          "401": {"description":"Session missing or expired"},
          "403": {"description":"Origin or profile mismatch"},
          "409": {"description":"Command already committed or UUID belongs to a different request", "content":{"application/json":{"schema":{"$ref":"#/components/schemas/FinanceError"}}}},
          "422": {"description":"Invalid command"},
          "428": {"description":"Original write precondition missing"},
          "429": {"description":"Rate limited"},
          "503": {"description":"Cancellation outcome unavailable; preserve the original queue"}
        }
      }
    },
    "/api/finance/v2/commands": {
      "post": {
        "summary": "Account CRUD, actual cash, verified linked payment record or atomic fact void and cash compensation (unapproved candidate)",
        "operationId": "accountV2CandidateCommands",
        "x-feature-off": true,
        "x-http-body-max-bytes": 32768,
        "x-reject-duplicate-json-keys": true,
        "x-verified-session-required": true,
        "x-no-client-identity": true,
        "security": [
          {
            "financeV2Cookie": []
          }
        ],
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 256,
              "pattern": "^\"[^\"\\r\\n]{1,254}\"$"
            },
            "description": "Strong server-issued ETag from authoritative /api/finance/v1/state"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "description": "Must exactly match the body client_mutation_id; preserve both on network retries"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountV2Candidate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay of already committed operation; no new debit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandReceipt"
                }
              }
            }
          },
          "201": {
            "description": "Newly committed single PostgreSQL transaction and durable receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected without a new financial posting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceError"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected without a new financial posting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceError"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected without a new financial posting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceError"
                }
              }
            }
          },
          "412": {
            "description": "Request rejected without a new financial posting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceError"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected without a new financial posting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceError"
                }
              }
            }
          },
          "422": {
            "description": "Request rejected without a new financial posting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceError"
                }
              }
            }
          },
          "428": {
            "description": "Request rejected without a new financial posting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceError"
                }
              }
            }
          },
          "429": {
            "description": "Request rejected without a new financial posting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceError"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected without a new financial posting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinanceError"
                }
              }
            }
          }
        }
      }
    }
  },
