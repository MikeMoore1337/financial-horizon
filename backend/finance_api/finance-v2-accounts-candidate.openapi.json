            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "action": {
            "type": "string",
            "enum": [
              "account.create",
              "account.update",
              "account.archive",
              "account.unarchive",
              "transaction.record",
              "settlement.payment.record",
              "loan.payment.record",
              "settlement.payment.void",
              "loan.payment.void",
              "reserve.create",
              "reserve.update",
              "reserve.archive",
              "reserve.allocate",
              "reserve.skip",
              "reserve.cycle.close",
              "reserve.event.void",
              "reserve.cycle.void"
            ]
          },
          "expected_entity_revisions": {
            "type": "object",
            "maxProperties": 100,
            "patternProperties": {
              "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false,
            "description": "Exactly all required entity revisions. Create: empty. Account change/transaction: account ID. Payment record: funding account and obligation/loan. Payment void: original transaction, fact, funding account. Checked by strict server validator. Reserve create: account plus obligation; update/archive: reserve; allocation: reserve plus account."
          },
          "payload": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "account.create"
                }
              }
            },
            "then": {
              "properties": {
